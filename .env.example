# Copie este arquivo para `.env` e preencha os valores:
#   cp .env.example .env
#
# O `.env` NÃO é versionado (veja o .gitignore).

# ---- Banco de dados (Postgres) ----
# Usados pelo serviço `db` para criar o usuário/banco na primeira subida,
# e pelo serviço `web` para montar a DATABASE_URL. Defina aqui uma única vez.
POSTGRES_USER=rafael
POSTGRES_PASSWORD=password
POSTGRES_DB=chiara_system

# ---- Segredo do Rails em produção ----
# Gere um valor com:  openssl rand -hex 64
SECRET_KEY_BASE=
